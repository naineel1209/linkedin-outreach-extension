{
  "manifest_version": 3,
  "name": "LinkedIn Peer Finder",
  "version": "1.2.0",
  "description": "Find people with LinkedIn or Google searches by job title and company.",
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "<all_urls>"
  ],
  "permissions": [
    "clipboardWrite",
    "offscreen"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://linkedin.com/jobs/view/*",
        "*://*.linkedin.com/jobs/view/*",
        "*://linkedin.com/jobs/search-results/*",
        "*://*.linkedin.com/jobs/search-results/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://linkedin.com/*",
        "*://*.linkedin.com/*"
      ],
      "js": ["profile-tools.js"],
      "css": ["profile-tools.css"],
      "run_at": "document_idle"
    }
  ]
}
