{
  "manifest_version": 3,
  "name": "LinkedIn Peer Finder",
  "version": "1.3.0",
  "description": "Find people with LinkedIn or Google searches by job title and company.",
  "background": {
    "scripts": ["background.common.js", "background.firefox.js"]
  },
  "host_permissions": [
    "<all_urls>"
  ],
  "permissions": [
    "clipboardWrite"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "linkedin-peer-finder@naineel.dev",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://linkedin.com/jobs/view/*",
        "*://*.linkedin.com/jobs/view/*",
        "*://linkedin.com/jobs/search-results/*",
        "*://*.linkedin.com/jobs/search-results/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://linkedin.com/*",
        "*://*.linkedin.com/*"
      ],
      "js": ["profile-tools.js"],
      "css": ["profile-tools.css"],
      "run_at": "document_idle"
    }
  ]
}
